# ==========================================================
#  环境变量示例 —— 复制为 .env 或直接在部署平台填写
#  （Railway / Render / Zeabur 等平台的 Variables 面板）
# ==========================================================

# ---- 服务端口（Railway 会自动注入，本地可留空，默认 8777）----
PORT=8777

# ---- 监听地址：部署到公网必须是 0.0.0.0 ----
HOST=0.0.0.0

# ---- AI 模型网关 ----
# 兼容 OpenAI 协议的 /v1 地址（不要带结尾斜杠）
EXAM_API_BASE=https://

# 你的 API Key。留空也可以，之后在网站「管理后台」里填。
EXAM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 默认模型（管理员可在后台随时切换）
EXAM_MODEL=DeepSeek-V4.1-Flash

# ---- 管理员密码 ----
# 首次启动时用它初始化管理员密码；之后可在后台修改。
# 若留空，则第一次打开 /#admin 时由页面提示设置。
ADMIN_PASSWORD=

# ---- 数据文件位置 ----
# 默认 <项目根>/data/db.json
# Railway 挂载 Volume 后建议指向持久化目录，例如：/data/db.json
# EXAM_DB_FILE=/data/db.json

# ---- 生产环境标记（生产环境会为 Cookie 加上 Secure）----
# NODE_ENV=production
